      "position": [
        -600,
        420
      ]
    },
    {
      "parameters": {
        "command": "=set N8N_RUNNERS_BROKER_PORT=5689&& set N8N_PORT=5699&& C:\\n8n\\bin\\n8n.cmd export:workflow --all --separate --output=\"C:/n8n-backup/{{ $now.toFormat('yyyy-MM-dd') }}\""
      },
      "id": "99d75a67-4567-4578-bfdf-7a780f5e74e3",
      "name": "Xuất toàn bộ workflow",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        -380,
        420
      ],
      "notes": "Đổi cổng tạm để lệnh CLI không đụng cổng 5678/5679 của n8n đang chạy. C:\\n8n\\bin\\n8n.cmd nạp C:\\n8n\\.env."
    },
    {
      "parameters": {
        "command": "powershell -NoProfile -Command \"Get-ChildItem 'C:/n8n-backup' -Directory | Where-Object { $_.LastWriteTime -lt (Get-Date).AddDays(-30) } | Remove-Item -Recurse -Force\""
      },
      "id": "03f6bb93-e65f-4964-8d16-b03044e67745",
