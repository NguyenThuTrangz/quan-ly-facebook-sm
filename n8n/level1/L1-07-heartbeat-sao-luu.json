          "timeout": 10000
        }
      },
      "id": "edc6c7cb-ae63-4d77-ada7-5f09f23fba86",
      "name": "Ping healthchecks",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -380,
        160
      ],
      "continueOnFail": true,
      "disabled": true,
      "notes": "TẮT sẵn. Muốn dùng: tạo check miễn phí ở healthchecks.io (chu kỳ 10 phút, grace 20 phút), dán link thay YOUR-UUID rồi bật node."
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "15 0 * * *"
            }
          ]
        }
      },
      "id": "a808056a-44b6-4200-aa48-e24c9d9cdb77",
      "name": "00:15 hằng ngày",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -600,
        420
      ]
    },
    {
      "parameters": {
        "command": "=set N8N_RUNNERS_BROKER_PORT=5689&& set N8N_PORT=5699&& C:\\n8n\\bin\\n8n.cmd export:workflow --all --separate --output=\"C:/n8n-backup/{{ $now.toFormat('yyyy-MM-dd') }}\""
      },
      "id": "e6a98ab4-14fe-41f9-8e9f-c1eb8ca6b0b9",
      "name": "Xuất toàn bộ workflow",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        -380,
        420
      ],
      "notes": "Đổi cổng tạm để lệnh CLI không đụng cổng 5678/5679 của n8n đang chạy. C:\\n8n\\bin\\n8n.cmd nạp C:\\n8n\\.env."
    },
    {
      "parameters": {
        "command": "powershell -NoProfile -Command \"Get-ChildItem 'C:/n8n-backup' -Directory | Where-Object { $_.LastWriteTime -lt (Get-Date).AddDays(-30) } | Remove-Item -Recurse -Force\""
      },
      "id": "21b58eb7-046b-4095-8459-93b7c1b59a6e",
      "name": "Xoá bản sao lưu > 30 ngày",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        -160,
        420
      ]
    }
  ],
